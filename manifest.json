{
  "manifest_version": 3,
  "name": "KinoX Dual Subtitles",
  "version": "1.2.1",
  "description": "Две синхронные дорожки SRT/VTT поверх видеоплееров на kinox.to.",
  "permissions": ["storage"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["subtitle-parser.js", "autosync.js", "content.js"],
      "css": ["styles.css"],
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true,
      "run_at": "document_idle"
    }
  ]
}
